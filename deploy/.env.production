# ============================================
# BAMBA PAY - PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to backend/.env and fill in your real values
# NEVER commit .env to GitHub - add it to .gitignore

# Server Configuration
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://bambapay.vercel.app

# Database - MongoDB Atlas (Get from https://cloud.mongodb.com)
# Format: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/bambapay?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JWT Security (Generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRE=7d

# Stripe Configuration (Get from https://dashboard.stripe.com/apikeys)
# Use TEST keys for development, LIVE keys for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_stripe_dashboard

# Admin Configuration
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Optional: Email Configuration (SendGrid/AWS SES)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
